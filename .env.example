# ==============================================================================
# WeatherGPT Backend Environment Configuration
# ==============================================================================
# All variables have built-in defaults. None are strictly required for local runs.

# Operational Mode: 'false' for live global NWP feeds, 'true' for offline demo
DEMO_MODE=false

# Conversational AI: Google Gemini API key (Optional - leave empty for built-in rule engine)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Weather Provider: 'open-meteo' (default, no key needed) or 'openweathermap'
WEATHER_PROVIDER=open-meteo
OPENWEATHERMAP_API_KEY=

# Database: SQLite default (zero-setup) or PostgreSQL connection URL
DATABASE_URL=sqlite:///./weathergpt.db

# Server
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
